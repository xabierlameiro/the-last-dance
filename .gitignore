# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# generated by `npm run coverage`; dropped from the repo in 265a521, never gitignored
/public/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Storybook
storybook-static/

migration/node_modules
migration/.next
# lean-ctx tool artifacts
.lean-ctx/

# local dev-server config (Claude Code Browser pane), machine-specific
.claude/launch.json

# Playwright artifacts (written into the repo root by `npm run test:e2e`)
/playwright-report
/test-results

# Visual baselines taken on a developer machine. The committed baseline is the Linux one, captured
# by .github/workflows/visual-baseline.yml on the same image that compares it; font rasterisation
# differs enough between platforms that a macOS capture can never match in CI. Running the suite
# locally is useful and writes here — it just must not reach a commit.
/e2e/visual/__screenshots__/*/darwin/
/e2e/visual/__screenshots__/*/win32/
