{
    "name": "the-last-dance",
    "type": "module",
    "version": "1.5.54",
    "description": "The Last Dance",
    "license": "MIT",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "prebuild": "node scripts/check-frontmatter/index.ts && node scripts/generate-llms.ts && node scripts/generate-feeds.ts",
        "debugg": "cross-env NODE_OPTIONS='--inspect' next dev",
        "prod": "npm install --legacy-peer-deps --silent",
        "build": "next build --webpack",
        "start:debugg": "cross-env NODE_OPTIONS='--inspect' next start",
        "start": "next start",
        "lint": "eslint .",
        "audit:prod": "node scripts/audit-gate.ts",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.tooling.json --noEmit",
        "test": "jest --silent",
        "coverage": "rm -rf public/coverage && jest --coverage --silent && node custom-reporter.ts",
        "watch": "jest --watchAll",
        "test:clear": "jest --clearCache",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "prettier": "prettier --write .",
        "jsdoc": "rm -rf public/docs && jsdoc -c jsdoc.json && node custom-docs.ts",
        "lighthouse-report": "node lighthouse/assets/lighthouse.ts",
        "posters": "node scripts/generate-post-posters.ts",
        "test:e2e": "playwright test",
        "test:e2e:report": "playwright test && node custom-report.ts",
        "next-info": "npx --no-install next info",
        "trending": "node scripts/trending/index.ts",
        "traffic-report": "node scripts/traffic-report/index.ts"
    },
    "dependencies": {
        "@code-hike/mdx": "^0.8.3",
        "@floating-ui/react": "^0.19.0",
        "@google-analytics/data": "^5.2.0",
        "@mdx-js/loader": "^2.3.0",
        "@mdx-js/react": "^2.3.0",
        "@next/mdx": "^16.3.6",
        "@vercel/analytics": "^2.0.1",
        "googleapis": "^173.0.0",
        "gray-matter": "^4.0.3",
        "jsdom": "^26.1.0",
        "next": "^16.3.6",
        "next-mdx-remote": "^6.0.0",
        "octokit": "^3.1.2",
        "react": "^19.1.0",
        "react-confetti": "^6.1.0",
        "react-dom": "^19.1.0",
        "react-icons": "^4.7.1",
        "react-intl": "^6.8.9",
        "remark-gfm": "^4.0.1",
        "shiki": "^0.10.1",
        "swr": "^2.0.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@babel/core": "^7.27.1",
        "@babel/preset-typescript": "^7.18.6",
        "@jest/globals": "^29.7.0",
        "@next/eslint-plugin-next": "^16.3.6",
        "@playwright/test": "^1.57.0",
        "@storybook/addon-links": "^10.6.0",
        "@storybook/nextjs": "^10.6.0",
        "@storybook/react": "^10.6.0",
        "@testing-library/dom": "^10.0.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.4.3",
        "@types/glob": "^8.0.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "chrome-launcher": "^1.2.0",
        "cross-env": "^7.0.3",
        "dotenv": "^16.4.5",
        "eslint": "^9.31.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-sonarjs": "^3.0.7",
        "eslint-plugin-storybook": "^10.6.0",
        "glob": "^11.1.0",
        "globals": "^14.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.3.1",
        "jest-fetch-mock": "^3.0.3",
        "jsdoc": "^4.0.2",
        "jsdoc-babel": "^0.5.0",
        "lighthouse": "^13.5.0",
        "prettier": "^3.9.6",
        "sharp": "^0.35.4",
        "storybook": "^10.6.0",
        "storybook-react-intl": "^10.2.2",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.63.0",
        "webpack": "^5.88.0"
    },
    "engines": {
        "node": "22.x",
        "npm": ">=10.0.0"
    },
    "overrides": {
        "eslint-plugin-sonarjs": {
            "minimatch": "^10.2.3"
        },
        "@storybook/builder-webpack5": {
            "webpack-dev-middleware": "8.3.0"
        },
        "brace-expansion@1": "1.1.21",
        "brace-expansion@2": "2.1.7",
        "brace-expansion@5": "5.0.12",
        "js-yaml@3": "^3.15.1",
        "nanoid@3": "^3.3.17",
        "sharp": "^0.35.4"
    },
    "resolutions": {
        "protobufjs": "^7.2.5",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@types/node": "^22.0.0",
        "webpack": "^5.88.0"
    },
    "browser": {
        "fs": false,
        "path": false,
        "os": false
    }
}
