{
    "name": "the-last-dance",
    "type": "module",
    "version": "1.5.60",
    "description": "The Last Dance",
    "license": "MIT",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "prebuild": "node scripts/check-frontmatter/index.ts && node scripts/generate-llms.ts && node scripts/generate-feeds.ts",
        "debugg": "cross-env NODE_OPTIONS='--inspect' next dev",
        "prod": "npm install --legacy-peer-deps --silent",
        "build": "next build --webpack",
        "start:debugg": "cross-env NODE_OPTIONS='--inspect' next start",
        "start": "next start",
        "lint": "eslint .",
        "audit:prod": "node scripts/audit-gate.ts",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.tooling.json --noEmit",
        "test": "jest --silent",
        "coverage": "rm -rf public/coverage && jest --coverage --silent && node custom-reporter.ts",
        "watch": "jest --watchAll",
        "test:clear": "jest --clearCache",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "prettier": "prettier --write .",
        "jsdoc": "rm -rf public/docs && jsdoc -c jsdoc.json && node custom-docs.ts",
        "lighthouse-report": "node lighthouse/assets/lighthouse.ts",
        "posters": "node scripts/generate-post-posters.ts",
        "test:e2e": "playwright test",
        "test:e2e:report": "playwright test && node custom-report.ts",
        "next-info": "npx --no-install next info",
        "trending": "node scripts/trending/index.ts",
        "traffic-report": "node scripts/traffic-report/index.ts"
    },
    "dependencies": {
        "@code-hike/mdx": "^0.8.3",
        "@floating-ui/react": "^0.27.20",
        "@google-analytics/data": "^7.2.1",
        "@mdx-js/loader": "^3.1.1",
        "@mdx-js/react": "^3.1.1",
        "@next/mdx": "^16.3.8",
        "@vercel/analytics": "^2.0.1",
        "googleapis": "^183.0.0",
        "gray-matter": "^4.0.3",
        "jsdom": "^30.1.2",
        "next": "^16.3.8",
        "next-mdx-remote": "^6.0.0",
        "octokit": "^5.0.5",
        "react": "^19.3.0",
        "react-confetti": "^6.1.0",
        "react-dom": "^19.3.0",
        "react-icons": "^5.7.0",
        "react-intl": "^12.1.3",
        "remark-gfm": "^4.0.1",
        "shiki": "^0.10.1",
        "swr": "^2.5.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@babel/core": "^8.0.6",
        "@babel/preset-typescript": "^8.0.1",
        "@jest/globals": "^30.5.2",
        "@next/eslint-plugin-next": "^16.3.8",
        "@playwright/test": "^1.63.0",
        "@storybook/addon-links": "^10.6.1",
        "@storybook/nextjs": "^10.6.1",
        "@storybook/react": "^10.6.0",
        "@testing-library/dom": "^10.0.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.4.3",
        "@types/glob": "^8.0.0",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "babel-plugin-react-compiler": "1.0.0",
        "chrome-launcher": "^1.2.2",
        "cross-env": "^10.1.0",
        "dotenv": "^18.0.5",
        "eslint": "^10.12.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-storybook": "^10.6.1",
        "glob": "^13.0.6",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "jest-fetch-mock": "^4.2.0",
        "jsdoc": "^4.0.5",
        "jsdoc-babel": "^0.5.0",
        "lighthouse": "^13.5.0",
        "prettier": "^3.9.9",
        "sharp": "^0.35.4",
        "storybook": "^10.6.1",
        "storybook-react-intl": "^10.2.2",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.71.0",
        "webpack": "^5.111.1"
    },
    "engines": {
        "node": "22.x",
        "npm": ">=10.0.0"
    },
    "overrides": {
        "eslint-plugin-sonarjs": {
            "minimatch": "^10.2.3"
        },
        "@storybook/builder-webpack5": {
            "webpack-dev-middleware": "8.3.0"
        },
        "brace-expansion@1": "1.1.21",
        "brace-expansion@2": "2.1.7",
        "brace-expansion@5": "5.0.12",
        "js-yaml@3": "^3.15.1",
        "nanoid@3": "^3.3.17",
        "sharp": "^0.35.4"
    },
    "resolutions": {
        "protobufjs": "^7.2.5",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/node": "^26.6.4",
        "webpack": "^5.111.1"
    },
    "browser": {
        "fs": false,
        "path": false,
        "os": false
    }
}
